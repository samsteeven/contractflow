# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Base de données (docker compose up -d postgres)
DB_HOST=127.0.0.1
DB_PORT=5438
DB_USER=contractflow
DB_PASSWORD=contractflow
DB_DATABASE=contractflow

# Documents PDF : `fs` (dossier storage/) ou `s3`. En local, MinIO : docker compose up -d s3
DRIVE_DISK=s3
S3_ENDPOINT=http://127.0.0.1:9008
S3_BUCKET=contractflow-documents
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=contractflow
AWS_SECRET_ACCESS_KEY=contractflow-secret

# Signature électronique : bac à sable intégré ; le secret signe les webhooks entrants
SIGNATURE_PROVIDER=sandbox
SIGNATURE_WEBHOOK_SECRET=dev-secret-a-remplacer-en-production
# E-mails de rappel : en local, Mailpit (docker compose up -d mailpit), interface sur le port 8035
MAIL_MAILER=smtp
MAIL_FROM_NAME=ContractFlow
MAIL_FROM_ADDRESS=notifications@contractflow.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1035

# File de tâches : Redis (docker compose up -d redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6389

# Antivirus des pièces jointes (clamd) ; sans hôte, tout ajout de fichier est refusé
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
